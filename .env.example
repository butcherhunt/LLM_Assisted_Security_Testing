# ─────────────────────────────────────────────
# AI-Powered Security Scanning MCP Server
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Base directory where all scan outputs are stored
# Defaults to ~/Automated_LLM_Scan if not set
BASE_SCAN_DIR=/your/custom/scan/directory

# ── MobSF (Mobile Security Framework) ────────
MOBSF_URL=http://127.0.0.1:8001
MOBSF_API_KEY=your_mobsf_api_key_here

# ── OWASP ZAP (DAST) ─────────────────────────
ZAP_URL=http://127.0.0.1:8090
ZAP_API_KEY=your_zap_api_key_here

# ── Ollama (Local LLM for analysis) ──────────
# Point to your local or remote Ollama instance
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2:7b
